# Copy to .env (git ignores it) and fill in. Read by examples/llm_extractor.py when started with
#   uv run --env-file .env lfe run examples.llm_extractor:LLMExtractor …
# Any OpenAI-compatible API works; the values below are for OpenRouter.

OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# an OpenRouter model id, see openrouter.ai/models
LFE_EXAMPLE_MODEL=google/gemini-2.5-flash
